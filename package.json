{
  "version": "1.0.0",
  "description": "service-template",
  "type": "module",
  "devDependencies": {
    "eslint-plugin-devup": "^2.0",
    "eslint": "^9",
    "lint-staged": "^16.2",
    "husky": "^9.1"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prelint": "cargo clippy -- -D warnings && cargo fmt --check && cargo check",
    "build": "bun run --workspace build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prelint:fix": "cargo clippy --fix && cargo fmt --write-mode=diff && cargo check",
    "test": "bun run --workspace test",
    "dev": "bun run --workspace dev",
    "api": "cargo run",
    "prepare": "husky",
    "changepacks": "bunx @changepacks/cli"
  },
  "author": "devfive"
}