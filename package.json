{
  "version": "1.0.0",
  "description": "service-template",
  "type": "module",
  "devDependencies": {
    "eslint-plugin-devup": "^2.0",
    "eslint": "^9",
    "lint-staged": "^16.2",
    "husky": "^9.1"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prelint": "uv run ruff check .",
    "build": "bun run --workspace build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prelint:fix": "uv run ruff check --fix .",
    "test": "bun run --workspace test",
    "dev": "bun run --workspace dev",
    "api": "uv run --package api --directory apis/api uvicorn main:app --reload",
    "prepare": "husky",
    "changepacks": "bunx @changepacks/cli"
  },
  "author": "devfive"
}